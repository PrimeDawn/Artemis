# Android and local IDE configuration
.gradle/
**/.gradle/
**/build/
local.properties
.idea/
*.iml
*.jks
*.keystore

# Node and generated outputs
node_modules/
**/node_modules/
dist/
coverage/
*.tsbuildinfo

# Local tool downloads, SDKs and extracted native libraries
.tools/
.cache/
*.apk
*.aar
*.aab

# Local credentials and machine state
.env
.env.*
!.env.example
*.log
!spec/**/artifacts/**/*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db


